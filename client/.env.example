# Base URL of the research API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# Set to "true" to serve clearly-labelled demo data instead of calling the backend.
# Never enabled automatically; the app does not fall back to mocks when the API fails.
VITE_USE_MOCK_API=false

# Optional. If your backend exposes a health endpoint, set its path (e.g. /health)
# and the connection indicator will probe it once on load and on Retry.
# Leave empty to derive connection status from normal API requests.
VITE_HEALTH_PATH=
