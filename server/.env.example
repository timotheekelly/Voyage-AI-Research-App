# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=research_intelligence

# LLM provider for answer generation via Spring AI (OpenAI by default; required)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Browser origins allowed to call the API (comma-separated). Never use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Authentication. Production: set a JWT issuer and leave the 'dev' profile OFF.
JWT_ISSUER_URI=
# Local development only: SPRING_PROFILES_ACTIVE=dev authenticates every request as the seeded user 'user-001'.
SPRING_PROFILES_ACTIVE=

FILE_STORAGE_DIR=./data/uploads
PORT=8080
